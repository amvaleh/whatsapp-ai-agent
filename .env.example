# Copy to .env and fill in your values

# Path to the whatsapp-bridge SQLite databases
WA_MESSAGES_DB=/path/to/whatsapp-bridge/store/messages.db
WA_STORE_DB=/path/to/whatsapp-bridge/store/whatsapp.db

# Admin UI port
WA_AGENT_PORT=3000

# URL prefix when served behind a reverse proxy (e.g. /wa-agent)
# Leave empty if serving at root
WA_AGENT_BASE_PATH=/wa-agent

# Optional: path for wa_agent.db (default: ./wa_agent.db)
# WA_AGENT_DB=./wa_agent.db
